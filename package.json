{
  "name": "licenseproof",
  "version": "0.3.5",
  "description": "Know every license in your dependency tree — before your customer's lawyer asks.",
  "keywords": [
    "license",
    "licenses",
    "license-compliance",
    "spdx",
    "sbom",
    "cyclonedx",
    "dependencies",
    "open-source-compliance",
    "gpl",
    "agpl",
    "attribution",
    "third-party-notices",
    "audit",
    "cli"
  ],
  "homepage": "https://licenseproof.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thrillhouse34/licenseproof.git"
  },
  "bugs": {
    "url": "https://github.com/thrillhouse34/licenseproof/issues"
  },
  "license": "Elastic-2.0",
  "bin": {
    "licenseproof": "dist/cli/index.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "puppeteer-core": "^25.3.0",
    "smol-toml": "^1.7.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
